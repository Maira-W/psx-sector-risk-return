table strategy_levels

	column date
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: date

	column strategy
		dataType: string
		summarizeBy: none
		sourceColumn: strategy
		sortByColumn: strategy_order

	column strategy_short
		dataType: string
		summarizeBy: none
		sourceColumn: strategy_short
		sortByColumn: strategy_order

	column strategy_order
		dataType: int64
		summarizeBy: none
		sourceColumn: strategy_order

	column level
		dataType: double
		formatString: 0
		summarizeBy: none
		sourceColumn: level

	partition strategy_levels = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [date = _t, strategy = _t, strategy_short = _t, strategy_order = _t, level = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"date", type date}, {"strategy", type text}, {"strategy_short", type text}, {"strategy_order", Int64.Type}, {"level", type number}}, "en-US")
				in
					Typed

