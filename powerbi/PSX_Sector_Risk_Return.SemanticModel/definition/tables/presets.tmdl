table presets

	column preset
		dataType: string
		summarizeBy: none
		sourceColumn: preset
		sortByColumn: preset_order

	column preset_order
		dataType: int64
		summarizeBy: none
		sourceColumn: preset_order

	column sector
		dataType: string
		summarizeBy: none
		sourceColumn: sector

	column short_name
		dataType: string
		summarizeBy: none
		sourceColumn: short_name

	column weight
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: weight

	partition presets = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [preset = _t, preset_order = _t, sector = _t, short_name = _t, weight = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"preset", type text}, {"preset_order", Int64.Type}, {"sector", type text}, {"short_name", type text}, {"weight", type number}}, "en-US")
				in
					Typed

