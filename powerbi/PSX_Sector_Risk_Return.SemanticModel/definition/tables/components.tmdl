table components

	column component_number
		dataType: int64
		summarizeBy: none
		sourceColumn: component_number

	column component
		dataType: string
		summarizeBy: none
		sourceColumn: component
		sortByColumn: component_number

	column share
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: share

	partition components = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("Lc25DcAwDEPRXVQbgQ7r8CxG9l8jhKKCzSv47yWh1ePHj292etclBWgjW+aRRgPYoGhU4wbsQVaJRgf4j5pe1hiAGAyZzwTkoJeexgLUoIUi9H4=", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [component_number = _t, component = _t, share = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"component_number", Int64.Type}, {"component", type text}, {"share", type number}}, "en-US")
				in
					Typed

