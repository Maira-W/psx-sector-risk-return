table rank_choices

	column sector
		dataType: string
		summarizeBy: none
		sourceColumn: sector

	column choice
		dataType: string
		summarizeBy: none
		sourceColumn: choice
		sortByColumn: choice_order

	column choice_short
		dataType: string
		summarizeBy: none
		sourceColumn: choice_short
		sortByColumn: choice_order

	column choice_order
		dataType: int64
		summarizeBy: none
		sourceColumn: choice_order

	column kind
		dataType: string
		summarizeBy: none
		sourceColumn: kind

	column sharpe
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: sharpe

	column position
		dataType: double
		summarizeBy: none
		sourceColumn: position

	partition rank_choices = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [sector = _t, choice = _t, choice_short = _t, choice_order = _t, kind = _t, sharpe = _t, position = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"sector", type text}, {"choice", type text}, {"choice_short", type text}, {"choice_order", Int64.Type}, {"kind", type text}, {"sharpe", type number}, {"position", type number}}, "en-US")
				in
					Typed

