table groups

	column group_letter
		dataType: string
		summarizeBy: none
		sourceColumn: group_letter

	column n_sectors
		dataType: int64
		summarizeBy: none
		sourceColumn: n_sectors

	column sectors
		dataType: string
		summarizeBy: none
		sourceColumn: sectors

	partition groups = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [group_letter = _t, n_sectors = _t, sectors = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"group_letter", type text}, {"n_sectors", Int64.Type}, {"sectors", type text}}, "en-US")
				in
					Typed

