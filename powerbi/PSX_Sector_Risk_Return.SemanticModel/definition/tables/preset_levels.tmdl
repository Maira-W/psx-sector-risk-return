table preset_levels

	column date
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: date

	column series
		dataType: string
		summarizeBy: none
		sourceColumn: series
		sortByColumn: series_order

	column level
		dataType: double
		formatString: 0
		summarizeBy: none
		sourceColumn: level

	column series_order
		dataType: int64
		summarizeBy: none
		sourceColumn: series_order

	partition preset_levels = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [date = _t, series = _t, level = _t, series_order = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"date", type date}, {"series", type text}, {"level", type number}, {"series_order", Int64.Type}}, "en-US")
				in
					Typed

