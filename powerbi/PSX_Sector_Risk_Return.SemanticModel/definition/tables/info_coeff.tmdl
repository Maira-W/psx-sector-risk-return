table info_coeff

	column decision_date
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: decision_date

	column information_coefficient
		dataType: double
		formatString: +0.00;-0.00
		summarizeBy: none
		sourceColumn: information_coefficient

	column direction
		dataType: string
		summarizeBy: none
		sourceColumn: direction

	partition info_coeff = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [decision_date = _t, information_coefficient = _t, direction = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"decision_date", type date}, {"information_coefficient", type number}, {"direction", type text}}, "en-US")
				in
					Typed

