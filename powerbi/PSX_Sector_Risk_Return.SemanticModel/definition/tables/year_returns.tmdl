table year_returns

	column sector
		dataType: string
		summarizeBy: none
		sourceColumn: sector

	column period_index
		dataType: int64
		summarizeBy: none
		sourceColumn: period_index

	column period
		dataType: string
		summarizeBy: none
		sourceColumn: period
		sortByColumn: period_index

	column period_return
		dataType: double
		formatString: 0%
		summarizeBy: none
		sourceColumn: period_return

	partition year_returns = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [sector = _t, period_index = _t, period = _t, period_return = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"sector", type text}, {"period_index", Int64.Type}, {"period", type text}, {"period_return", type number}}, "en-US")
				in
					Typed

