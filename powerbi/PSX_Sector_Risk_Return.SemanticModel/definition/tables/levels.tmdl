table levels

	column date
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: date

	column series
		dataType: string
		summarizeBy: none
		sourceColumn: series

	column level
		dataType: double
		formatString: 0
		summarizeBy: none
		sourceColumn: level

	column drawdown_pct
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: drawdown_pct

	partition levels = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [date = _t, series = _t, level = _t, drawdown_pct = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"date", type date}, {"series", type text}, {"level", type number}, {"drawdown_pct", type number}}, "en-US")
				in
					Typed

