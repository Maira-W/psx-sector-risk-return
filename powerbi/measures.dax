// Measures for the PSX sector risk and return report. Generated by `python -m psxsec report`.
// All measures live in a table called _Measures. A year-filtered measure keeps the year in a VAR:
// filtering a column by a measure inside CALCULATE makes the measure invalid in Power BI.
// The table called levels is written 'levels' in DAX, because the bare word is read as a keyword.

// ---------- The whole market ----------

// Compound annual return of the whole market (every qualifying company, equal-weighted, dividends included).
Market Return a Year = MAX ( market[market_cagr] )

// What cash would have earned at the State Bank of Pakistan's policy rate, compounded.
Cash Return a Year = MAX ( market[cash_cagr] )

Market Excess Return a Year = [Market Return a Year] - [Cash Return a Year]

Market Volatility = MAX ( market[market_volatility] )

Market Worst Fall = MAX ( market[market_max_drawdown] )

// Return above cash per unit of risk for the whole market, scaled to a year.
Market Sharpe = MAX ( market[market_sharpe] )

Market Return in Dollars a Year = MAX ( market[market_usd_cagr] )

Companies Analysed = MAX ( market[n_companies] )

Top Sector by Sharpe = SELECTEDVALUE ( market[top_sector] )

Top Sector Sharpe = MAX ( market[top_sharpe] )

// ---------- Return and risk ----------

Sector Count = COUNTROWS ( sectors )

// Compound annual return of the sector index (equal-weighted, rebalanced monthly, dividends included).
Return a Year = AVERAGE ( sectors[cagr] )

// Standard deviation of daily returns, scaled to a year.
Volatility = AVERAGE ( sectors[volatility] )

// The largest drop from a peak to a later low of the sector's growth-of-100 series.
Worst Fall = AVERAGE ( sectors[max_drawdown] )

// Average daily return above cash divided by its standard deviation, scaled to a year.
Sharpe Ratio = AVERAGE ( sectors[sharpe] )

// Lower end of the 95% range from resampling the days 2,000 times.
Sharpe Ratio Low = AVERAGE ( sectors[sharpe_lo] )

// Upper end of the 95% range from resampling the days 2,000 times.
Sharpe Ratio High = AVERAGE ( sectors[sharpe_hi] )

Companies = SUM ( sectors[n_companies] )

Dividend Points = AVERAGE ( sectors[dividend_points] )

Return in Dollars a Year = AVERAGE ( sectors[usd_cagr] )

Rank by Sharpe = AVERAGE ( sectors[rank_sharpe] )

Sectors Clearly Better Than Market = COALESCE ( CALCULATE ( COUNTROWS ( sectors ), sectors[p_beats_market] >= 0.95 ), 0 )

Sectors Clearly Worse Than Market = COALESCE ( CALCULATE ( COUNTROWS ( sectors ), sectors[p_beats_market] <= 0.05 ), 0 )

Sector Year Return = AVERAGE ( year_returns[period_return] )

Market Year Return =
CALCULATE (
    AVERAGE ( market_years[period_return] ),
    TREATAS ( VALUES ( year_returns[period_index] ), market_years[period_index] )
)

Highlight Level = AVERAGE ( levels_top[level] )

// Growth of 100 rupees for the series picked in the list (one to eight). Until something is picked it draws the whole market and cash.
Selected Level =
VAR picked = COUNTROWS ( ALLSELECTED ( 'levels'[series] ) )
VAR shown = SELECTEDVALUE ( 'levels'[series] )
RETURN
    IF ( picked <= 8 || shown IN { "Whole market", "Cash at the policy rate" }, AVERAGE ( 'levels'[level] ), BLANK () )

// How far below its previous high each picked series was, in percent (one to eight). Until something is picked it draws the whole market and cash.
Selected Drawdown =
VAR picked = COUNTROWS ( ALLSELECTED ( 'levels'[series] ) )
VAR shown = SELECTEDVALUE ( 'levels'[series] )
RETURN
    IF ( picked <= 8 || shown IN { "Whole market", "Cash at the policy rate" }, AVERAGE ( 'levels'[drawdown_pct] ), BLANK () )

// ---------- How sure ----------

// Share of the 2,000 resampled histories in which the sector had the best Sharpe ratio.
Chance of First = AVERAGE ( sectors[p_top1] )

// Share of the 2,000 resampled histories in which the sector was in the top three by Sharpe ratio.
Chance of Top 3 = AVERAGE ( sectors[p_top3] )

// Share of the resampled histories in which the sector's Sharpe ratio beat the whole market's.
Chance Better Than Market = AVERAGE ( sectors[p_beats_market] )

Sectors With a 10% Chance of First = COALESCE ( CALCULATE ( COUNTROWS ( sectors ), sectors[p_top1] >= 0.1 ), 0 )

Top Sector Chance of First = MAX ( market[top_p1] )

// Position by Sharpe ratio (1 is best) under the main analysis and each of the twelve other ways of doing it.
Rank in Each Analysis = AVERAGE ( rank_choices[position] )

Method Rank Correlation (median) = MAX ( market[method_rank_correlation_median] )

Method Rank Correlation (lowest) = MAX ( market[method_rank_correlation_min] )

Date Rank Correlation (lowest) = MAX ( market[period_rank_correlation_min] )

First vs Second Half Correlation = MAX ( market[half_correlation] )

// ---------- Skill or luck ----------

// How strongly the sector follows the rest of the market (every company outside that sector); 1 means one for one.
Beta = AVERAGE ( sectors[beta] )

// Return a year that the rest of the market does not explain (weekly market model with the Dimson correction).
Alpha a Year = AVERAGE ( sectors[alpha] )

Alpha t = AVERAGE ( sectors[alpha_t] )

// Two-sided p-value of the alpha, tested for this sector on its own (Newey-West errors).
Alpha p Alone = AVERAGE ( sectors[alpha_p] )

// p-value after allowing for having looked at every ranked sector (Romano-Wolf resampling test).
Alpha p Corrected = AVERAGE ( sectors[alpha_p_adjusted] )

// False-discovery-rate version of the p-value (Benjamini-Hochberg): a looser rule that lets a small share of false findings through.
Alpha q = AVERAGE ( sectors[alpha_q] )

Sortino Ratio = AVERAGE ( sectors[sortino] )

// Average return on the worst 5% of days (expected shortfall at 95%).
Bad Day Loss = AVERAGE ( sectors[cvar_95] )

// Sector's average gain in the months the rest of the market rose, as a share of the market's own.
Up Capture = AVERAGE ( sectors[up_capture] )

// Sector's average loss in the months the rest of the market fell, as a share of the market's own.
Down Capture = AVERAGE ( sectors[down_capture] )

// Chance that the true Sharpe ratio beats what the best of all the sectors would reach by luck alone.
Deflated Sharpe = AVERAGE ( sectors[dsr] )

Longest Fall (months) = AVERAGE ( sectors[longest_fall_months] )

Alpha Significant Alone = COALESCE ( CALCULATE ( COUNTROWS ( sectors ), sectors[alpha_p] < 0.05 ), 0 )

// Sectors whose alpha stays significant at 5% once the test allows for looking at all of them.
Alpha Significant After Correction = COALESCE ( CALCULATE ( COUNTROWS ( sectors ), sectors[alpha_p_adjusted] < 0.05 ), 0 )

Alpha Significant Looser Rule = COALESCE ( CALCULATE ( COUNTROWS ( sectors ), sectors[alpha_q] < 0.05 ), 0 )

Best Alpha = MAX ( market[best_alpha] )

Best Alpha Sector = SELECTEDVALUE ( market[best_alpha_sector] )

Best Alpha p Corrected = MAX ( market[best_alpha_p_adjusted] )

Best Deflated Sharpe = MAX ( market[best_dsr] )

// The Sharpe ratio the best of all the sectors would be expected to reach if none had any skill.
Luck Bar for Sharpe = MAX ( market[expected_best_sharpe] )

// ---------- What moves the sectors ----------

// Extra return in a month, in percent, for each percentage point the policy rate rose, with the rest of the market held fixed.
Rate Effect = AVERAGE ( sectors[rate_beta] )

// Extra return in a month, in percent, for each 1% the rupee weakened against the dollar, with the rest of the market held fixed.
Rupee Effect = AVERAGE ( sectors[fx_beta] )

// Share of all the variation in sector returns carried by the first principal component, the market-wide movement.
Market Share of Variation = MAX ( market[pc1_share] )

// How many equally important independent sources of risk would give the same concentration of variance.
Effective Bets = MAX ( market[effective_bets] )

Average Correlation = MAX ( market[mean_correlation] )

// Average correlation between two sectors after the part the rest of the market explains is taken out.
Average Correlation Without Market = MAX ( market[residual_mean_correlation] )

Sectors Reacting to Rates = MAX ( market[n_rate_fdr] )

Sectors Reacting to the Rupee = MAX ( market[n_fx_fdr] )

Component Share = AVERAGE ( components[share] )

Component 1 Loading = AVERAGE ( sectors[component_1] )

Component 2 Loading = AVERAGE ( sectors[component_2] )

// ---------- Out of sample ----------

// Growth of 100 rupees of a rule that chooses weights each month using only the previous 12 months.
Strategy Level = AVERAGE ( strategy_levels[level] )

// Sharpe ratio of holding the three sectors with the best past Sharpe ratio, chosen anew each month.
Winners Sharpe = CALCULATE ( AVERAGE ( strategies[sharpe] ), strategies[strategy_key] = "winners" )

Equal Weight Sharpe = CALCULATE ( AVERAGE ( strategies[sharpe] ), strategies[strategy_key] = "equal_weight" )

Winners p Alone = CALCULATE ( AVERAGE ( strategies[vs_equal_p] ), strategies[strategy_key] = "winners" )

// p-value of that rule's Sharpe ratio against equal weights, multiplied by the five comparisons made.
Winners p Corrected = CALCULATE ( AVERAGE ( strategies[vs_equal_p_adjusted] ), strategies[strategy_key] = "winners" )

Minimum Variance Sharpe = CALCULATE ( AVERAGE ( strategies[sharpe] ), strategies[strategy_key] = "min_variance" )

Minimum Variance p Corrected = CALCULATE ( AVERAGE ( strategies[vs_equal_p_adjusted] ), strategies[strategy_key] = "min_variance" )

// Rank correlation between the sectors' Sharpe ratios over the previous 12 months and their returns in the next month.
Information Coefficient = AVERAGE ( info_coeff[information_coefficient] )

Months Tested = MAX ( market[wf_months] )

Months Pointing the Right Way =
DIVIDE (
    CALCULATE ( COUNTROWS ( info_coeff ), info_coeff[information_coefficient] > 0 ),
    COUNTROWS ( info_coeff )
)

// ---------- Preset portfolios ----------

// Share of the portfolio in the sector. The presets are worked out with hindsight from the whole five years.
Preset Weight = AVERAGE ( presets[weight] )

Preset Level = AVERAGE ( preset_levels[level] )

Preset Return a Year = AVERAGE ( preset_stats[cagr] )

Preset Volatility = AVERAGE ( preset_stats[volatility] )

Preset Worst Fall = AVERAGE ( preset_stats[max_drawdown] )

Preset Sharpe = AVERAGE ( preset_stats[sharpe] )
